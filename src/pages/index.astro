---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <!-- SECTION 1: JOINTLY ORGANISED BY (FIRST) -->
  <section class="section organisers-section" aria-labelledby="organisers-heading">
    <div class="container">
      <div class="organisers-header">
        <h2 id="organisers-heading" class="organisers-heading">Jointly organised by</h2>
      </div>

      <div class="organisers-grid">
        <!-- CARD 1: ARIES Nainital (Short logo only) -->
        <article class="organisation-card">
          <div class="card-logo-area">
            <img
              src="/images/aries-emblem.png"
              alt="ARIES official logo"
              class="org-logo aries-logo"
              width="180"
              height="85"
              loading="eager"
            />
          </div>
          <h3 class="org-name">ARIES Nainital</h3>
        </article>

        <!-- CARD 2: University of Delhi -->
        <article class="organisation-card">
          <div class="card-logo-area">
            <img
              src="/images/du-logo.jpg"
              alt="University of Delhi official logo"
              class="org-logo du-logo"
              width="110"
              height="85"
              loading="eager"
            />
          </div>
          <h3 class="org-name">University of Delhi</h3>
        </article>

        <!-- CARD 3: IIT Delhi -->
        <article class="organisation-card">
          <div class="card-logo-area">
            <img
              src="/images/iit-delhi-logo.png"
              alt="IIT Delhi official logo"
              class="org-logo iit-logo"
              width="85"
              height="85"
              loading="eager"
            />
          </div>
          <h3 class="org-name">IIT Delhi</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION 2: SPONSORED BY (AFTER ORGANISERS) -->
  <section class="section sponsor-section" aria-labelledby="sponsor-heading">
    <div class="container sponsor-container">
      <div class="sponsor-content">
        <h2 id="sponsor-heading" class="sponsor-kicker">Sponsored by</h2>
        
        <p class="sponsor-department">Department of Science and Technology (DST), Government of India</p>
        
        <div class="sponsor-reference">
          <span class="ref-label">Project Reference:</span>
          <span class="ref-code">DST/ICD/Call-5/BRICS/SAPTARISI/2023/G</span>
        </div>

        <div class="sponsor-logo-area">
          <img
            src="/images/dst.png"
            alt="Department of Science and Technology (DST), Government of India official logo"
            class="dst-logo"
            width="140"
            height="100"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================================
     HOME PAGE — ORGANISERS & SPONSOR PRESENTATION
     ========================================================================= */

  /* ---------------- SECTION 1: JOINTLY ORGANISED BY ---------------- */
  .organisers-section {
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    background: #ffffff;
  }

  .organisers-header {
    text-align: center;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .organisers-heading {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    font-weight: 700;
    color: var(--navy-900);
    letter-spacing: -0.01em;
  }

  /* 3 Equal Cards Grid */
  .organisers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    max-width: 1140px;
    margin-inline: auto;
  }

  /* Premium Institutional Organisation Card */
  .organisation-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--blue-700);
    border-radius: var(--r-lg);
    box-shadow: 0 4px 16px -2px rgba(16, 29, 71, 0.06), 0 2px 4px -1px rgba(16, 29, 71, 0.03);
    padding: clamp(1.75rem, 3vw, 2.35rem) 1.5rem;
    min-height: 240px;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-top-color 0.2s ease;
    box-sizing: border-box;
  }

  .organisation-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(16, 29, 71, 0.1), 0 4px 8px -2px rgba(16, 29, 71, 0.04);
    border-top-color: var(--orange-500);
  }

  /* Consistent Logo Container Area */
  .card-logo-area {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 105px;
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .org-logo {
    object-fit: contain;
    display: block;
    max-height: 100%;
  }

  /* Balanced Logo Constraints */
  .aries-logo {
    max-width: 175px;
    max-height: 78px;
    height: auto;
  }

  .du-logo {
    max-width: 115px;
    max-height: 88px;
    height: auto;
  }

  .iit-logo {
    max-width: 88px;
    max-height: 88px;
    height: auto;
  }

  .org-name {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.08rem, 1.25vw, 1.25rem);
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  /* ---------------- SECTION 2: SPONSORED BY ---------------- */
  .sponsor-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }

  .sponsor-container {
    max-width: 860px;
    margin-inline: auto;
  }

  /* Open, elegant, balanced sponsor block */
  .sponsor-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.5rem, 3vw, 2.25rem) 1.5rem;
    box-sizing: border-box;
  }

  .sponsor-kicker {
    margin: 0 0 0.65rem;
    font-family: var(--font-head);
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    font-weight: 700;
    color: var(--orange-600);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .sponsor-department {
    margin: 0 0 0.85rem;
    font-family: var(--font-head);
    font-size: clamp(1.18rem, 1.6vw, 1.45rem);
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 680px;
  }

  .sponsor-reference {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 0.45rem 0.95rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 1px 3px rgba(16, 29, 71, 0.04);
  }

  .ref-label {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--navy-900);
    letter-spacing: 0.01em;
  }

  .ref-code {
    font-family: var(--font-mono, monospace);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-700);
    letter-spacing: 0.02em;
  }

  .sponsor-logo-area {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dst-logo {
    width: auto;
    max-width: 140px;
    max-height: 90px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(16, 29, 71, 0.06));
  }

  /* ---------------- RESPONSIVE BREAKPOINTS ---------------- */
  @media (max-width: 900px) {
    .organisers-grid {
      gap: 1.25rem;
    }
    .organisation-card {
      padding: 1.5rem 1rem;
      min-height: 215px;
    }
    .card-logo-area {
      height: 90px;
    }
  }

  @media (max-width: 680px) {
    .organisers-grid {
      grid-template-columns: 1fr;
      max-width: 380px;
      margin-inline: auto;
      gap: 1.15rem;
    }
    .organisation-card {
      min-height: 190px;
      padding: 1.5rem 1.25rem;
    }
    .card-logo-area {
      height: 85px;
      margin-bottom: 1rem;
    }
    .sponsor-content {
      padding-inline: 0.75rem;
    }
    .sponsor-reference {
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.5rem 0.85rem;
    }
    .dst-logo {
      max-width: 125px;
    }
  }
</style>
