---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <!-- SECTION 1: BRICS WORKSHOP POSTER (BEFORE ORGANISERS) -->
  <section class="section poster-section" aria-label="Conference Poster">
    <div class="container poster-container">
      <div class="poster-wrapper">
        <img
          src="/images/brics.png"
          alt="International Workshop on Synergistic Investigation of Stellar Clusters and Asteroseismology using High-Resolution Spectroscopy and Space Photometry — Official Workshop Poster"
          class="poster-image"
          width="1056"
          height="1490"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 2: JOINTLY ORGANISED BY -->
  <section class="section organisers-section" aria-labelledby="organisers-heading">
    <div class="container">
      <div class="organisers-header">
        <h2 id="organisers-heading" class="organisers-heading">Jointly organised by</h2>
      </div>

      <div class="organisers-grid">
        <!-- CARD 1: ARIES Nainital (Short logo only) -->
        <article class="organisation-card">
          <div class="card-accent" aria-hidden="true"></div>
          <div class="card-inner">
            <div class="card-logo-area">
              <img
                src="/images/aries-short-logo.png"
                alt="ARIES official logo"
                class="org-logo aries-logo"
                width="180"
                height="88"
                loading="eager"
              />
            </div>
            <div class="card-name-area">
              <h3 class="org-name">ARIES Nainital</h3>
            </div>
          </div>
        </article>

        <!-- CARD 2: University of Delhi -->
        <article class="organisation-card">
          <div class="card-accent" aria-hidden="true"></div>
          <div class="card-inner">
            <div class="card-logo-area">
              <img
                src="/images/du-logo.jpg"
                alt="University of Delhi official logo"
                class="org-logo du-logo"
                width="125"
                height="100"
                loading="eager"
              />
            </div>
            <div class="card-name-area">
              <h3 class="org-name">University of Delhi</h3>
            </div>
          </div>
        </article>

        <!-- CARD 3: IIT Delhi -->
        <article class="organisation-card">
          <div class="card-accent" aria-hidden="true"></div>
          <div class="card-inner">
            <div class="card-logo-area">
              <img
                src="/images/iit-delhi-logo.png"
                alt="IIT Delhi official logo"
                class="org-logo iit-logo"
                width="100"
                height="100"
                loading="eager"
              />
            </div>
            <div class="card-name-area">
              <h3 class="org-name">IIT Delhi</h3>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION 3: SPONSORED BY (AFTER ORGANISERS) -->
  <section class="section sponsor-section" aria-labelledby="sponsor-heading">
    <div class="container sponsor-container">
      <div class="sponsor-content">
        <h2 id="sponsor-heading" class="sponsor-kicker">Sponsored by</h2>
        
        <p class="sponsor-department">Department of Science and Technology (DST), Government of India</p>
        
        <div class="sponsor-reference">
          <span class="ref-label">Project Reference:</span>
          <span class="ref-code">DST/ICD/Call-5/BRICS/SAPTARISI/2023/G</span>
        </div>

        <div class="sponsor-logo-area">
          <img
            src="/images/dst.png"
            alt="Department of Science and Technology (DST), Government of India official logo"
            class="dst-logo"
            width="140"
            height="95"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================================
     HOME PAGE — POSTER, ORGANISERS & SPONSOR PRESENTATION
     ========================================================================= */

  /* ---------------- SECTION 1: BRICS WORKSHOP POSTER ---------------- */
  .poster-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    background: #ffffff;
  }

  .poster-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .poster-wrapper {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    display: flex;
    justify-content: center;
  }

  .poster-image {
    width: 100%;
    max-width: 680px;
    height: auto;
    display: block;
    border-radius: 10px;
    box-shadow: 0 4px 6px -1px rgba(16, 29, 71, 0.07), 0 14px 30px -4px rgba(16, 29, 71, 0.13);
    border: 1px solid rgba(16, 29, 71, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .poster-image:hover {
    box-shadow: 0 8px 14px -2px rgba(16, 29, 71, 0.09), 0 20px 40px -4px rgba(16, 29, 71, 0.16);
  }

  /* ---------------- SECTION 2: JOINTLY ORGANISED BY ---------------- */
  .organisers-section {
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.75rem);
    background: #ffffff;
    border-top: 1px solid rgba(16, 29, 71, 0.06);
  }

  .organisers-header {
    text-align: center;
    margin-bottom: clamp(1.85rem, 3.5vw, 2.75rem);
  }

  .organisers-heading {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    font-weight: 700;
    color: var(--navy-950);
    letter-spacing: -0.015em;
  }

  /* 3 Equal Cards Grid: Clean maximum-width container */
  .organisers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2rem);
    max-width: 1060px;
    margin-inline: auto;
  }

  /* Premium Institutional Organisation Card with Elevated Depth */
  .organisation-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
    border: 1px solid rgba(16, 29, 71, 0.09);
    border-radius: 14px;
    box-shadow: 0 4px 6px -1px rgba(16, 29, 71, 0.05), 0 10px 24px -4px rgba(16, 29, 71, 0.08);
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
    box-sizing: border-box;
    height: 100%;
    min-height: 290px;
  }

  /* Smooth, Refined Hover Lift */
  .organisation-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 18px -3px rgba(16, 29, 71, 0.08), 0 20px 36px -4px rgba(16, 29, 71, 0.13);
    border-color: rgba(232, 111, 27, 0.38);
  }

  /* Elegant Top Orange Accent Bar */
  .card-accent {
    height: 4px;
    width: 100%;
    background: linear-gradient(90deg, var(--orange-500) 0%, #f97316 100%);
    flex-shrink: 0;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: clamp(2rem, 3.5vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) 1.85rem;
    box-sizing: border-box;
    width: 100%;
    flex: 1;
  }

  /* Dedicated Centered Logo Container with Consistent Height */
  .card-logo-area {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 145px;
    width: 100%;
    margin-bottom: 1.25rem;
    padding-inline: 0.5rem;
    box-sizing: border-box;
  }

  .org-logo {
    object-fit: contain;
    display: block;
    width: auto;
    height: auto;
    transition: transform 0.25s ease;
  }

  .organisation-card:hover .org-logo {
    transform: scale(1.03);
  }

  /* Balanced Logo Sizing across different aspect ratios */
  .aries-logo {
    max-width: 185px;
    max-height: 90px;
  }

  .du-logo {
    max-width: 125px;
    max-height: 102px;
  }

  .iit-logo {
    max-width: 100px;
    max-height: 100px;
  }

  /* Consistent bottom placement & typography for organisation name */
  .card-name-area {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
  }

  .org-name {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.15rem, 1.35vw, 1.3rem);
    font-weight: 700;
    color: var(--navy-950);
    line-height: 1.35;
    text-align: center;
    letter-spacing: -0.01em;
  }

  /* ---------------- SECTION 3: SPONSORED BY ---------------- */
  .sponsor-section {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }

  .sponsor-container {
    max-width: 860px;
    margin-inline: auto;
  }

  /* Open, elegant, balanced sponsor block */
  .sponsor-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.5rem, 3vw, 2.25rem) 1.5rem;
    box-sizing: border-box;
  }

  .sponsor-kicker {
    margin: 0 0 0.65rem;
    font-family: var(--font-head);
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    font-weight: 700;
    color: var(--orange-600);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .sponsor-department {
    margin: 0 0 0.85rem;
    font-family: var(--font-head);
    font-size: clamp(1.18rem, 1.55vw, 1.4rem);
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 680px;
  }

  .sponsor-reference {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 0.45rem 0.95rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 1px 3px rgba(16, 29, 71, 0.04);
  }

  .ref-label {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--navy-900);
    letter-spacing: 0.01em;
  }

  .ref-code {
    font-family: var(--font-mono, monospace);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-700);
    letter-spacing: 0.02em;
  }

  .sponsor-logo-area {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dst-logo {
    width: auto;
    max-width: 140px;
    max-height: 90px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(16, 29, 71, 0.06));
  }

  /* ---------------- RESPONSIVE BREAKPOINTS ---------------- */
  @media (max-width: 900px) {
    .poster-wrapper {
      max-width: 82%;
    }
    .organisers-grid {
      gap: 1.25rem;
    }
    .card-inner {
      padding: 1.75rem 1rem 1.6rem;
      min-height: 250px;
    }
    .card-logo-area {
      height: 125px;
    }
  }

  @media (max-width: 680px) {
    .poster-wrapper {
      max-width: 94%;
    }
    .organisers-grid {
      grid-template-columns: 1fr;
      max-width: 380px;
      margin-inline: auto;
      gap: 1.25rem;
    }
    .organisation-card {
      min-height: 250px;
    }
    .card-inner {
      padding: 1.75rem 1.25rem 1.5rem;
    }
    .card-logo-area {
      height: 120px;
      margin-bottom: 1rem;
    }
    .sponsor-content {
      padding-inline: 0.75rem;
    }
    .sponsor-reference {
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.5rem 0.85rem;
    }
    .dst-logo {
      max-width: 125px;
    }
  }
</style>
