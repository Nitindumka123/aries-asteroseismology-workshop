---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <section class="section sponsor-section">
    <div class="container sponsor-inner">
      <div class="sponsor-copy">
        <span class="eyebrow">Sponsored by</span>
        <h1>Department of Science and Technology (DST), Government of India</h1>
        <p><span>DST Reference:</span> DST/ICD/Call-5/BRICS/SAPTARISI/2023/G</p>
      </div>
      <img class="dst-logo" src="/images/dst.png" alt="Department of Science and Technology, Government of India" width="240" height="180" />
    </div>
  </section>

  <section class="section organisers-section">
    <div class="container">
      <div class="section-head center"><span class="eyebrow">Jointly organised by</span></div>
      <div class="organiser-grid">
        <article class="organiser-box"><img src="/images/aries-logo.png" alt="ARIES official logo" /><h2>ARIES Nainital</h2></article>
        <article class="organiser-box"><img src="/images/du-logo.jpg" alt="University of Delhi official logo" /><h2>University of Delhi</h2></article>
        <article class="organiser-box"><img src="/images/iit-delhi-logo.png" alt="IIT Delhi official logo" /><h2>IIT Delhi</h2></article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sponsor-section { background: linear-gradient(135deg, var(--bg-soft), #fff); }
  .sponsor-inner { display: flex; align-items: center; justify-content: center; gap: clamp(2rem, 6vw, 5rem); max-width: 940px; }
  .sponsor-copy { min-width: 0; }
  .sponsor-copy h1 { max-width: 650px; margin: .25rem 0 .75rem; font-size: clamp(1.7rem, 3.5vw, 2.8rem); }
  .sponsor-copy p { color: var(--ink-600); font-size: 1rem; }
  .sponsor-copy p span { font-family: var(--font-head); font-weight: 700; color: var(--navy-900); }
  .dst-logo { width: min(180px, 28vw); height: auto; object-fit: contain; flex: none; }
  .organisers-section { padding-top: 1rem; }
  .section-head.center { margin-bottom: 1.5rem; }
  .organiser-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .organiser-box { min-width: 0; min-height: 230px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.1rem; padding: 1.5rem; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--orange-500); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); text-align: center; }
  .organiser-box img { width: 100%; height: 125px; object-fit: contain; }
  .organiser-box h2 { font-size: 1.25rem; margin: 0; }
  @media (max-width: 700px) { .sponsor-inner { flex-direction: column-reverse; text-align: center; gap: 1rem; } .dst-logo { width: 145px; } .organiser-grid { grid-template-columns: 1fr; } .organiser-box { min-height: 200px; } }
</style>
