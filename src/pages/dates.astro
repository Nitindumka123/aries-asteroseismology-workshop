---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { dates, event } from '../data/site';
---
<BaseLayout title="Dates">
  <PageHeader
    eyebrow="Schedule"
    title="Important Dates"
    intro="Key milestones for the International Workshop on Interdisciplinary Asteroseismology of CP Stars and Star Clusters to be held in March 2027."
  />

  <section class="section">
    <div class="container dates-layout">
      <div class="dates-main card">
        <Timeline items={dates} />
      </div>
      <aside class="dates-side">
        <div class="event-card">
          <span class="ec-kicker"><Icon name="star" size={16} /> Workshop</span>
          <p class="ec-dates">{event.dates}</p>
          <p class="ec-venue"><Icon name="map-pin" size={16} /> {event.venue}</p>
          <a href="/registration" class="btn btn-on-dark" style="width:100%;margin-top:1rem;">Participation details</a>
        </div>
        <div class="note">
          <p class="note-title">Participation note</p>
          <p>This event is organized under the DST SAPTARISI project (<code>{event.projectCode}</code>). Approximately 75 participants from ~20 countries are invited directly by the organizing committees.</p>
        </div>
      </aside>
    </div>
  </section>

  <style>
    .dates-layout { display: grid; grid-template-columns: 1.6fr 1fr; gap: 2.5rem; align-items: start; }
    .dates-main { padding: 2rem; }
    .dates-side { display: grid; gap: 1.25rem; position: sticky; top: calc(var(--header-h) + 1rem); }
    .event-card { background: var(--navy-900); color: #cdd6ee; border-radius: var(--r-lg); padding: 1.6rem;
      background-image: radial-gradient(340px 200px at 100% 0%, rgba(232,111,27,0.28), transparent 70%); }
    .ec-kicker { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--orange-400); font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.78rem; }
    .ec-dates { font-family: var(--font-head); font-weight: 800; color: #fff; font-size: 1.7rem; margin: 0.6rem 0 0.4rem; line-height: 1.1; }
    .ec-venue { display: flex; gap: 0.45rem; align-items: flex-start; font-size: 0.95rem; margin: 0; }
    .ec-venue :global(svg) { color: var(--orange-400); flex: none; margin-top: 3px; }
    @media (max-width: 900px) {
      .dates-layout { grid-template-columns: 1fr; gap: 1.75rem; }
      .dates-side { position: static; }
      .dates-main { padding: 1.5rem; }
    }
  </style>
</BaseLayout>
