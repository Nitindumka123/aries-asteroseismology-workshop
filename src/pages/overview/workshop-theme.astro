---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { topics } from '../../data/site';
---
<BaseLayout title="Workshop Theme">
  <PageHeader eyebrow="Overview" title="Workshop Theme" intro="The five scientific themes guiding the workshop." />
  <section class="section"><div class="container"><ol class="themes">{topics.map((topic, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p>{topic}</p></li>)}</ol></div></section>
</BaseLayout>

<style>
  .themes { display: grid; gap: 1rem; max-width: 900px; margin: 0 auto; padding: 0; list-style: none; counter-reset: theme; }
  .themes li { display: flex; gap: 1rem; align-items: flex-start; border: 1px solid var(--line); border-left: 4px solid var(--orange-500); border-radius: var(--r-md); padding: 1.25rem; background: #fff; box-shadow: var(--shadow-sm); }
  .themes span { color: var(--orange-600); font-family: var(--font-head); font-weight: 800; }
  .themes p { margin: 0; color: var(--navy-900); font-weight: 600; }
</style>
