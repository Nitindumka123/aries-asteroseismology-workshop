---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Excursion">
  <PageHeader
    eyebrow="Excursion"
    title="Excursion"
    intro="An optional post-workshop excursion to the historic monument of the Taj Mahal in Agra, planned for 11 February 2027."
  />

  <section class="section">
    <div class="container content-layout">
      <div class="prose">
        <!-- Prominent Main Content Heading for the Excursion -->
        <div class="excursion-headline-wrap">
          <span class="section-kicker">Destination</span>
          <h2 class="excursion-main-title">Taj Mahal, Agra</h2>
        </div>

        <!-- Prominent Cost Responsibility Notice -->
        <div class="excursion-cost-notice" role="note">
          <div class="notice-header">
            <Icon name="info" size={22} />
            <h3 class="notice-heading">Excursion Cost Responsibility</h3>
          </div>
          <p class="cost-primary-statement">
            <strong>Participants have to pay for their own excursion costs.</strong>
          </p>
          <p class="cost-secondary-statement">
            Excursion expenses are NOT covered by the workshop. Participants will be responsible for their own excursion expenses.
          </p>
        </div>

        <p>
          The Taj Mahal is a UNESCO World Heritage Site and one of the world's most celebrated architectural wonders, situated on the south bank of the Yamuna river in Agra. Built by Mughal Emperor Shah Jahan, it stands as a pinnacle of Indo-Islamic Mughal architecture.
        </p>
        <p>
          The planned excursion offers visiting delegates and researchers an opportunity to visit Agra and experience this historic site following the scientific sessions.
        </p>

        <div class="excursion-section-head">
          <span class="section-kicker">Travel Options</span>
          <h3>General Route &amp; Travel Guidance</h3>
        </div>
        <p>
          Exact shared arrangements are not finalized. Participants traveling from the venue at Delhi University South Campus can consider the following standard travel options to Agra:
        </p>
        <ul class="options-list">
          <li>
            <strong>Train:</strong> Regular rail connectivity from New Delhi / Hazrat Nizamuddin railway stations to Agra Cantt railway station, followed by local ground transport to the monument.
          </li>
          <li>
            <strong>Flight:</strong> Commercial flights connecting to Agra airport, subject to commercial airline schedules and individual delegate itinerary planning.
          </li>
          <li>
            <strong>Bus / Road:</strong> Highway travel connecting New Delhi to Agra via the Yamuna Expressway by bus, tourist coach, or private taxi.
          </li>
        </ul>

        <div class="excursion-section-head">
          <span class="section-kicker">Registration</span>
          <h3>Excursion Opt-in</h3>
        </div>
        <div class="optin-box">
          <p>
            Participants interested in joining the excursion should select <strong>YES</strong> under <strong>"Excursion Opt-in"</strong> in the registration form.
          </p>
          <div class="optin-actions">
            <a href="/registration" class="btn btn-primary">Go to Registration Form</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-layout {
    max-width: 840px;
    margin-inline: auto;
  }

  /* Main Excursion Heading */
  .excursion-headline-wrap {
    margin-bottom: 1.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--line);
  }

  .excursion-main-title {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.85rem, 3.2vw, 2.45rem);
    font-weight: 800;
    color: var(--navy-950);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  /* Prominent Cost Notice */
  .excursion-cost-notice {
    background: #fff8f0;
    border: 1px solid #ffd8a8;
    border-left: 5px solid var(--orange-500);
    border-radius: var(--r-md);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: 0 2px 8px rgba(232, 111, 27, 0.06);
  }

  .notice-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    color: var(--orange-700);
  }

  .notice-heading {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-950);
  }

  .cost-primary-statement {
    margin: 0 0 0.5rem;
    font-size: 1.12rem;
    color: var(--navy-950);
    line-height: 1.5;
  }

  .cost-primary-statement strong {
    color: var(--orange-700);
    font-weight: 700;
  }

  .cost-secondary-statement {
    margin: 0;
    font-size: 1.02rem;
    color: var(--ink-700);
    line-height: 1.55;
    font-weight: 500;
  }

  /* Section Headings */
  .excursion-section-head {
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  .section-kicker {
    display: block;
    font-family: var(--font-head);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--orange-600);
    margin-bottom: 0.35rem;
  }

  .excursion-section-head h3 {
    margin: 0;
    font-family: var(--font-head);
    color: var(--navy-900);
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    font-weight: 700;
  }

  .options-list {
    margin: 1rem 0 2rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .options-list li {
    line-height: 1.6;
    color: var(--ink-700);
  }

  .options-list strong {
    color: var(--navy-900);
  }

  .optin-box {
    background: #f4f7fc;
    border: 1px solid rgba(30, 51, 127, 0.15);
    border-radius: var(--r-md);
    padding: 1.5rem 1.75rem;
    margin-top: 1rem;
  }

  .optin-box p {
    margin: 0;
    color: var(--ink-700);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .optin-actions {
    margin-top: 1.25rem;
  }
</style>
