---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Agra Taj Mahal Excursion">
  <PageHeader
    eyebrow="Excursion &amp; Social"
    title="Agra Taj Mahal Excursion"
    intro="The Taj Mahal excursion is planned for 11 February 2027, the fourth and final scheduled day."
  />

  <section class="section">
    <div class="container content-layout">
      <div class="prose">
        <div class="excursion-warning" role="note">
          <h2><Icon name="info" size={20} /> Important expense notice</h2>
          <p><strong>Excursion expenses are NOT covered by the workshop.</strong> All travel, transportation, accommodation, food, entry tickets, and other personal expenses related to the excursion will be borne by the participants themselves.</p>
        </div>

        <figure class="excursion-image">
          <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Taj_Mahal%2C_Agra%2C_UP%2C_India.jpg/1280px-Taj_Mahal%2C_Agra%2C_UP%2C_India.jpg" alt="Taj Mahal in Agra" loading="lazy" width="1280" height="853" />
          <figcaption>Taj Mahal, Agra</figcaption>
        </figure>

        <span class="eyebrow">Excursion highlight</span>
        <h2>Taj Mahal, Agra</h2>
        <p>The Taj Mahal is a UNESCO World Heritage Site and one of India's most iconic monuments. It was built by Mughal emperor Shah Jahan in memory of Mumtaz Mahal.</p>
        <p>The excursion day provides an opportunity for participants to visit the Taj Mahal in Agra after the workshop programme.</p>

        <h3>General Route Guidance</h3>
        <p>Exact arrangements are not finalized. Participants should use the following general options from the Delhi University South Campus venue:</p>
        <ul>
          <li><strong>Train:</strong> Rail travel from New Delhi-area stations to Agra, followed by local transport to the Taj Mahal.</li>
          <li><strong>Flight:</strong> Air travel options to the Agra area may be considered, subject to availability and participant arrangements.</li>
          <li><strong>Bus / road:</strong> Road travel from New Delhi to Agra by bus, coach, or private vehicle.</li>
        </ul>

        <h3>Excursion Opt-in</h3>
        <p>If you are interested in joining the excursion, please select the <strong>YES</strong> option under the "Excursion Opt-in" field when submitting your <a href="/registration">Online Registration Form</a>.</p>
        <div class="cluster" style="margin-top: 1.5rem;">
          <a href="/registration" class="btn btn-primary">Registration Portal</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .content-layout { max-width: 820px; margin-inline: auto; }
    .excursion-warning { background: var(--orange-50); border: 1px solid var(--orange-100); border-left: 4px solid var(--orange-500); border-radius: var(--r-md); padding: 1.1rem 1.3rem; }
    .excursion-warning h2 { display: flex; align-items: center; gap: 0.5rem; color: #78350f; font-size: 1.2rem; margin: 0 0 0.5rem; }
    .excursion-warning h2 :global(svg) { flex: none; }
    .excursion-warning p { color: #78350f; margin: 0; }
    .excursion-image { margin: 2rem 0; }
    .excursion-image img { width: 100%; max-width: 560px; max-height: 320px; object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--shadow-md); }
    .excursion-image figcaption { color: var(--ink-500); font-size: 0.9rem; margin-top: 0.45rem; }
    .prose strong { color: var(--navy-900); }
    .prose a { overflow-wrap: anywhere; }
    @media (max-width: 620px) { .excursion-image img { max-height: 240px; } }
  </style>
</BaseLayout>
