---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { event } from '../data/site';
---
<BaseLayout title=" Agra Taj Mahal Excursion">
  <PageHeader
    eyebrow="Social Events"
    title="Agra Taj Mahal Excursion"
    intro="An optional post-workshop sightseeing trip to the iconic Taj Mahal in Agra, Uttar Pradesh."
  />

  <section class="section">
    <div class="container content-layout">
      <div class="prose">
        <span class="eyebrow">Sightseeing Trip</span>
        <h2>Taj Mahal, Agra</h2>
        <p>
          Following the conclusion of the technical sessions, the organising committee is planning an optional group excursion to Agra, home of the Taj Mahal—one of the Seven Wonders of the Ancient and Modern World.
        </p>

        <div class="note" style="margin-top:1.5rem; margin-bottom:1.5rem;">
          <h3 class="note-title"><Icon name="info" size={18} /> Important Expense Notice</h3>
          <p>
            Please note that **excursion expenses will be borne entirely by the participants**. The workshop registration and DST project funds do not cover travel, dining, or entry ticket fees for the Agra excursion.
          </p>
        </div>

        <h3>Trip Overview</h3>
        <ul>
          <li><strong>Destination:</strong> Taj Mahal &amp; Agra Fort, Agra, Uttar Pradesh (approx. 220 km from New Delhi via Yamuna Expressway).</li>
          <li><strong>Date &amp; Schedule:</strong> To be finalized closer to the event date and communicated to participants who opted in during registration.</li>
          <li><strong>Transport:</strong> Group travel options (e.g., dedicated AC coach or express train connection) will be coordinated based on participant numbers.</li>
          <li><strong>Expenses:</strong> Coordinated group billing for transport/entry will be shared directly among participating delegates.</li>
        </ul>

        <h3>Excursion Opt-in</h3>
        <p>
          If you are interested in joining the excursion, please select the <strong>YES</strong> option under the "Excursion Opt-in" field when submitting your <a href="/registration">Online Registration Form</a>.
        </p>
        <div style="margin-top: 1.5rem;">
          <a href="/registration" class="btn btn-primary">Go to Registration Portal</a>
          <a href="/participants" class="btn btn-secondary" style="margin-left: 0.5rem;">View Registered Directory</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .content-layout { max-width: 820px; margin-inline: auto; }
    .note h3 { display: flex; align-items: center; gap: 0.5rem; color: #78350f !important; }
    .note p { font-size: 0.95rem; color: #78350f; margin: 0; line-height: 1.5; }
    .prose strong { color: var(--navy-900); }
  </style>
</BaseLayout>
