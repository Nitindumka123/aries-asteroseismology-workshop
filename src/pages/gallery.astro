---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { carousel, imageCredits } from '../data/site';
---
<BaseLayout title="Photo Gallery">
  <PageHeader
    eyebrow="Media & History"
    title="Photo Gallery"
    intro="Visual highlights of the participating institutions, campus facilities, and conference environments."
  />

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Visuals</span>
        <h2>Institutional Campus Gallery</h2>
        <p>A compilation of the primary campuses and facilities collaborating on the BRICS Asteroseismology Workshop.</p>
      </div>

      <div class="gallery-grid">
        {carousel.map((img) => (
          <div class="gallery-card card">
            <div class="gallery-img-wrapper">
              <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
            </div>
            <div class="gallery-info">
              <span class="gallery-kicker">{img.kicker}</span>
              <h3 class="gallery-title">{img.title}</h3>
              <p class="gallery-desc">{img.text}</p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="note blue" style="margin-top: 3rem;">
        <h3 class="note-title"><Icon name="shield-check" size={18} /> Official Image Credits</h3>
        <ul style="margin: 0.5rem 0 0; padding-left: 1.2rem; font-size: 0.92rem; line-height: 1.6; color: var(--blue-700);">
          {imageCredits.map((credit) => (
            <li><strong>{credit.label}:</strong> Provided by {credit.by} &mdash; License: {credit.lic} (via {credit.via})</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .gallery-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem; }
    .gallery-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
    .gallery-img-wrapper { width: 100%; height: 260px; overflow: hidden; position: relative; }
    .gallery-img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
    .gallery-card:hover .gallery-img-wrapper img { transform: scale(1.03); }
    .gallery-info { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
    .gallery-kicker { font-family: var(--font-head); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--orange-600); margin-bottom: 0.4rem; }
    .gallery-title { font-size: 1.25rem; color: var(--navy-900); margin-bottom: 0.5rem; }
    .gallery-desc { font-size: 0.94rem; color: var(--ink-500); margin: 0; line-height: 1.5; }

    @media (max-width: 768px) {
      .gallery-grid { grid-template-columns: 1fr; gap: 1.5rem; }
      .gallery-img-wrapper { height: 200px; }
    }
  </style>
</BaseLayout>
