---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { event, travel, host, institute } from '../data/site';
---
<BaseLayout title="Venue">
  <PageHeader
    eyebrow="Location"
    title="Venue"
    intro="The International Workshop is held at Delhi University, South Campus, conveniently located in the national capital."
  />

  <section class="section">
    <div class="container venue-grid">
      <div>
        <span class="eyebrow">Host Campus &amp; Venue</span>
        <h2>{host.name}</h2>
        <p class="lead">{host.note}</p>

        <ul class="meta-list" style="margin-top:1.5rem;">
          <li>
            <span class="m-ic"><Icon name="map-pin" size={20} /></span>
            <div><span class="m-k">Venue</span><br /><span class="m-v">{host.name}, New Delhi</span></div>
          </li>
          <li>
            <span class="m-ic"><Icon name="calendar" size={20} /></span>
            <div><span class="m-k">Dates</span><br /><span class="m-v">{event.dates}</span></div>
          </li>
          <li>
            <span class="m-ic"><Icon name="building" size={20} /></span>
            <div><span class="m-k">Address</span><br /><span class="m-v">{host.location}</span></div>
          </li>
        </ul>

        <a href={travel.mapUrl} target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top:1.5rem;">
          <Icon name="map" size={18} /> Open in Google Maps <Icon name="external" size={15} />
        </a>
      </div>

      <aside class="map-card">
        <div class="map-visual" aria-hidden="true">
          <Icon name="map-pin" size={40} />
          <span>DU South Campus</span>
        </div>
        <div class="map-body">
          <p class="note-title">Getting to the venue</p>
          <p>Delhi University South Campus is situated on Benito Juarez Marg near Dhaula Kuan. It offers swift access from IGI Airport and major railway terminals via the Delhi Metro (Pink Line and Airport Express Line).</p>
          <a href="/venue-and-travel" class="link-arrow">Detailed travel &amp; transit information <Icon name="arrow-right" size={16} /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Nearest transit points</span><h2>Reaching Delhi University South Campus</h2></div>
      <div class="grid grid-4">
        {travel.points.map((p) => (
          <div class="card accent">
            <span class="card-icon"><Icon name={p.mode.includes('Air') ? 'plane' : p.mode.includes('Rail') ? 'compass' : p.mode.includes('Metro') ? 'target' : 'map-pin'} size={22} /></span>
            <h4>{p.mode}</h4>
            <p>{p.place}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="note blue org-address">
        <div>
          <p class="note-title">Organising Institute — ARIES, Nainital</p>
          <p>{institute.name}, {institute.address}. Phone: {institute.phone}.</p>
        </div>
        <a href="/venue-and-travel" class="btn btn-ghost">Travel details</a>
      </div>
    </div>
  </section>

  <style>
    .venue-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: start; }
    .map-card { border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); background: #fff; }
    .map-visual { height: 200px; display: grid; place-items: center; gap: 0.5rem; color: #fff;
      background: linear-gradient(135deg, var(--blue-700), var(--navy-900));
      background-image: radial-gradient(300px 160px at 80% 20%, rgba(232,111,27,0.35), transparent 70%), linear-gradient(135deg, var(--blue-700), var(--navy-900)); }
    .map-visual span { font-family: var(--font-head); font-weight: 700; letter-spacing: 0.05em; }
    .map-visual :global(svg) { color: var(--orange-400); }
    .map-body { padding: 1.4rem; }
    .link-arrow { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--font-head); font-weight: 700; color: var(--blue-700); margin-top: 0.5rem; }
    .link-arrow:hover { color: var(--orange-600); }
    .org-address { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
    @media (max-width: 900px) { .venue-grid { grid-template-columns: 1fr; gap: 2rem; } }
  </style>
</BaseLayout>
