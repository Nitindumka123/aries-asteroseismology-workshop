---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Overview">
  <PageHeader eyebrow="Scientific Scope" title="Overview" intro="Explore the scientific rationale, workshop themes, and information for participants." />
  <section class="section">
    <div class="container overview-links">
      <a class="card accent" href="/overview/scientific-rationale"><h2>Scientific Rationale</h2><p>The scientific motivation for bringing asteroseismology and stellar cluster studies together.</p></a>
      <a class="card accent" href="/overview/workshop-theme"><h2>Workshop Theme</h2><p>The five scientific themes of the workshop.</p></a>
      <a class="card accent" href="/overview/information-to-participants"><h2>Information to Participants</h2><p>Poster, oral presentation, and code of conduct guidance.</p></a>
    </div>
  </section>
</BaseLayout>

<style>
  .overview-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .overview-links a { color: inherit; }
  .overview-links h2 { font-size: 1.35rem; margin-bottom: .65rem; }
  .overview-links p { color: var(--ink-500); }
  @media (max-width: 800px) { .overview-links { grid-template-columns: 1fr; } }
</style>
