---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Conference Poster">
  <PageHeader
    eyebrow="Resources"
    title="Conference Poster"
    intro="Official workshop poster for the International Workshop on Synergistic Investigation of Stellar Clusters and Asteroseismology."
  />

  <section class="section">
    <div class="container content-layout">
      <div class="poster-update-box" role="status">
        <p class="poster-update-title">Conference Poster Update</p>
        <p class="poster-update-text">The official workshop poster is currently being updated and will be available for viewing and download soon.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-layout {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .poster-update-box {
    background: var(--bg-soft, #f8fafc);
    border: 1px dashed var(--line, #cbd5e1);
    border-radius: var(--r-md, 12px);
    padding: 2.25rem 2.5rem;
    max-width: 620px;
    width: 100%;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .poster-update-title {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy-900, #101d47);
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .poster-update-text {
    color: var(--ink-500, #475569);
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.6;
  }
</style>
