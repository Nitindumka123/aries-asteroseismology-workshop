---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Conference Poster">
  <PageHeader
    eyebrow="Resources"
    title="Conference Poster"
    intro="Official workshop poster for the International Workshop on Synergistic Investigation of Stellar Clusters and Asteroseismology."
  />

  <section class="section">
    <div class="container content-layout">
      <div class="poster-actions">
        <a
          href="/images/brics.png"
          download="BRICS_Workshop_Poster_2027.png"
          class="btn btn-primary download-btn"
        >
          <Icon name="download" size={18} />
          <span>Download High-Resolution Poster (PNG)</span>
        </a>
      </div>

      <div class="poster-display-frame">
        <img
          src="/images/brics.png"
          alt="International Workshop on Synergistic Investigation of Stellar Clusters and Asteroseismology using High-Resolution Spectroscopy and Space Photometry — Official Poster"
          class="poster-img"
          width="1056"
          height="1490"
          loading="eager"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-layout {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .poster-actions {
    margin-bottom: 2rem;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.6rem;
    font-weight: 600;
    border-radius: var(--r-md);
  }

  .poster-display-frame {
    width: 100%;
    max-width: 760px;
    display: flex;
    justify-content: center;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(16, 29, 71, 0.08), 0 16px 36px -4px rgba(16, 29, 71, 0.15);
    border: 1px solid rgba(16, 29, 71, 0.1);
    overflow: hidden;
  }

  .poster-img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 680px) {
    .poster-display-frame {
      max-width: 100%;
      border-radius: 8px;
    }

    .download-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
