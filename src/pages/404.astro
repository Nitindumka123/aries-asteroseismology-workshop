---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found.">
  <section class="section nf">
    <div class="container narrow center">
      <span class="nf-code">404</span>
      <h1>Page not found</h1>
      <p class="lead">The page you're looking for doesn't exist or may have moved. Let's get you back on track.</p>
      <div class="cluster center" style="margin-top:1.5rem;">
        <a href="/" class="btn btn-primary btn-lg">Back to home <Icon name="arrow-right" size={18} /></a>
        <a href="/overview" class="btn btn-ghost btn-lg">Overview</a>
      </div>
    </div>
  </section>
  <style>
    .nf { padding-block: clamp(4rem, 12vw, 8rem); }
    .nf-code { font-family: var(--font-head); font-weight: 800; font-size: clamp(4rem, 14vw, 8rem); line-height: 1; color: var(--orange-500); display: block; }
    .nf h1 { margin: 0.5rem 0 0.75rem; }
  </style>
</BaseLayout>
