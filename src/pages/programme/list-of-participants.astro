---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
---
<BaseLayout title="List of Participants">
  <PageHeader
    eyebrow="Programme"
    title="List of Participants"
    intro="The confirmed roster of registered participants and institutional delegates."
  />

  <section class="section">
    <div class="container coming-soon-container">
      <div class="status-card">
        <div class="status-icon" aria-hidden="true">
          <Icon name="users" size={32} />
        </div>
        <h2 class="status-title">List of Participants</h2>
        <p class="status-message">Will be updated soon.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .coming-soon-container {
    max-width: 680px;
    margin-inline: auto;
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .status-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-top: 4px solid var(--orange-500);
    border-radius: var(--r-lg);
    box-shadow: 0 4px 20px -2px rgba(16, 29, 71, 0.06);
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .status-icon {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #fff6ee;
    border: 1px solid rgba(232, 111, 27, 0.25);
    color: var(--orange-600);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .status-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-head);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 700;
    color: var(--navy-950);
  }

  .status-message {
    margin: 0 0 1rem;
    font-family: var(--font-head);
    font-size: clamp(1.1rem, 1.4vw, 1.28rem);
    font-weight: 600;
    color: var(--orange-600);
  }

  .status-note {
    margin: 0;
    color: var(--ink-700);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 480px;
  }
</style>
