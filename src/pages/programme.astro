---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Programme">
  <PageHeader eyebrow="Academic content" title="Programme" intro="Details about the workshop programme will be provided soon." />
  <section class="section">
    <div class="container narrow">
      <div class="section-head"><span class="eyebrow">Structure</span><h2>How the workshop is organised</h2></div>
      <p class="programme-placeholder">Details will be provided soon.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .programme-placeholder { background: var(--blue-50); border: 1px solid var(--blue-100); border-left: 4px solid var(--blue-600); border-radius: var(--r-md); padding: 1.1rem 1.3rem; color: var(--navy-900); font-family: var(--font-head); font-weight: 700; }
</style>
