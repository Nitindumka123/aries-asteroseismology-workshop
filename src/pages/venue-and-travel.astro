---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { travel, event, institute, host } from '../data/site';

const iconFor = (mode: string) =>
  mode.includes('Air') ? 'plane' : mode.includes('Rail') ? 'compass' : mode.includes('Bus') || mode.includes('Road') ? 'building' : mode.includes('Metro') ? 'target' : 'map-pin';
---
<BaseLayout title="Venue and Travel information">
  <PageHeader
    eyebrow="More · Getting there"
    title="Venue and Travel Information"
    intro="How to reach Delhi University, South Campus by air, rail, metro and road, with indicative local transit information."
  />

  <section class="section">
    <div class="container vt-grid">
      <div>
        <span class="eyebrow">The Venue</span>
        <h2>{event.venue}</h2>
        <p class="lead">The workshop is hosted at Delhi University, South Campus, situated on Benito Juarez Marg near Dhaula Kuan in New Delhi. The campus is exceptionally well connected to international and domestic transit hubs.</p>
        <a href={travel.mapUrl} target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top:1rem;">
          <Icon name="map" size={18} /> Open location in Google Maps <Icon name="external" size={15} />
        </a>
      </div>
      <div class="map-visual" aria-hidden="true">
        <Icon name="map-pin" size={40} />
        <span>DU South Campus</span>
        <small>New Delhi, India</small>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Access points</span><h2>Reaching the Campus</h2><p>Indicative local taxi and metro connections to Delhi University South Campus.</p></div>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th>Mode</th><th>Nearest Point / Station</th><th>Indicative Transit / Fare</th></tr>
          </thead>
          <tbody>
            {travel.points.map((p) => (
              <tr>
                <td><span class="mode-cell"><Icon name={iconFor(p.mode)} size={18} /> {p.mode}</span></td>
                <td>{p.place}</td>
                <td>{p.fare}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="note" style="margin-top:1.5rem;">
        <p class="note-title">Metro Connectivity</p>
        <p>The <strong>Durgabai Deshmukh South Campus Metro Station</strong> on the Delhi Metro Pink Line is located immediately adjacent to the campus footbridge, providing rapid connectivity across the national capital.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="note blue org-address">
        <div>
          <p class="note-title">Organising Institute — ARIES, Nainital</p>
          <p>{institute.name}, {institute.address}. Phone: {institute.phone}.</p>
        </div>
        <a href="/accommodation" class="btn btn-ghost">Accommodation details</a>
      </div>
    </div>
  </section>

  <style>
    .vt-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: center; }
    .map-visual { height: 220px; border-radius: var(--r-lg); display: grid; place-items: center; align-content: center; gap: 0.35rem; color: #fff;
      background-image: radial-gradient(320px 180px at 80% 15%, rgba(232,111,27,0.4), transparent 70%), linear-gradient(135deg, var(--blue-700), var(--navy-950)); }
    .map-visual span { font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; letter-spacing: 0.04em; }
    .map-visual small { color: #b9c4e0; }
    .map-visual :global(svg) { color: var(--orange-400); }
    .mode-cell { display: inline-flex; align-items: center; gap: 0.5rem; }
    .mode-cell :global(svg) { color: var(--orange-500); flex: none; }
    .org-address { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
    @media (max-width: 900px) { .vt-grid { grid-template-columns: 1fr; gap: 2rem; } }
  </style>
</BaseLayout>
