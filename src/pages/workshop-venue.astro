---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const mapSearchQuery = 'Institute of Informatics & Communication (IIC), University of Delhi South Campus, Benito Juarez Marg, New Delhi, Delhi 110021, India';
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(mapSearchQuery)}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
const mapExternalUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapSearchQuery)}`;
---

<BaseLayout title="Workshop Venue | Logistics">
  <PageHeader
    eyebrow="Logistics"
    title="Workshop Venue"
    intro="Venue details for the International Workshop on Synergistic Investigation of Stellar Clusters and Asteroseismology."
  />

  <section class="section" style="padding-top: 0.5rem;">
    <div class="container content-wrap">
      <article class="venue-card">
        <h2 class="main-heading">Workshop Venue</h2>

        <!-- Venue / Location Section -->
        <div class="venue-info-block">
          <h3 class="section-subheading">Venue / Location</h3>

          <div class="institution-name">
            Institute of Informatics and Communication
          </div>

          <div class="address-box">
            <p class="address-line campus-line">
              LIBRARY, UNIVERSITY OF DELHI SOUTH CAMPUS, South Campus, South Moti Bagh, New Delhi, Delhi 110021, India
            </p>
            <div class="address-divider"></div>
            <p class="address-line postal-line">
              Institute of Informatics &amp; Communication (IIC)<br />
              University of Delhi, South Campus<br />
              Benito Juarez Marg<br />
              New Delhi - 110021, India
            </p>
          </div>
        </div>

        <!-- Event Dates Section -->
        <div class="dates-block">
          <h3 class="section-subheading">Event Dates</h3>
          <p class="dates-value">8–11 February 2027</p>
        </div>

        <!-- Google Maps Location Section -->
        <div class="map-section">
          <div class="map-header">
            <h3 class="map-title">Location Map</h3>
            <a
              href={mapExternalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary map-link-btn"
            >
              <Icon name="external" size={15} />
              <span>Open in Google Maps</span>
            </a>
          </div>

          <div class="map-frame-wrapper">
            <iframe
              title="Google Map: Institute of Informatics & Communication (IIC), University of Delhi South Campus"
              src={mapEmbedUrl}
              class="map-iframe"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .content-wrap {
    max-width: 860px;
    margin-inline: auto;
  }

  .venue-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: var(--shadow-sm);
  }

  .main-heading {
    margin: 0 0 1.75rem;
    font-size: clamp(1.8rem, 3.2vw, 2.35rem);
    font-weight: 800;
    color: var(--navy-950);
    letter-spacing: -0.02em;
    line-height: 1.2;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--line);
  }

  .venue-info-block {
    margin-bottom: 2rem;
  }

  .section-subheading {
    margin: 0 0 0.85rem;
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-500);
  }

  .institution-name {
    font-family: var(--font-head);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--navy-950);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .address-box {
    background: #f8fafc;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.35rem 1.5rem;
  }

  .address-line {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--navy-900);
  }

  .campus-line {
    font-weight: 600;
    color: var(--navy-950);
  }

  .address-divider {
    height: 1px;
    background: var(--line);
    margin: 1rem 0;
  }

  .postal-line {
    font-weight: 500;
    color: var(--ink-700);
  }

  /* Dates Block */
  .dates-block {
    margin-bottom: 2.25rem;
    padding: 1.25rem 1.5rem;
    background: #fff8ed;
    border: 1px solid #fed7aa;
    border-radius: var(--r-md);
  }

  .dates-block .section-subheading {
    color: #9a3412;
    margin-bottom: 0.35rem;
  }

  .dates-value {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 700;
    color: #c2410c;
  }

  /* Map Section */
  .map-section {
    margin-top: 2rem;
  }

  .map-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .map-title {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy-950);
  }

  .map-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    padding: 0.5rem 1rem;
  }

  .map-frame-wrapper {
    width: 100%;
    height: 420px;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    background: #eef2f7;
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 640px) {
    .map-frame-wrapper {
      height: 300px;
    }

    .map-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .map-link-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
