---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { event, convenor } from '../data/site';

const steps = [
  { icon: 'passport', title: 'Check Visa Requirements', text: 'Foreign nationals require a valid passport and an Indian Conference Visa (or e-Conference Visa) to enter India. Check details via official Government of India portals.' },
  { icon: 'doc', title: 'Official Invitation Letter', text: 'Invited foreign participants will be provided with an official Letter of Invitation issued by ARIES, Nainital and the organizing committee for visa processing.' },
  { icon: 'shield', title: 'Government Clearances', text: 'The workshop is held under the aegis of DST (Govt. of India), and necessary administrative clearances will be coordinated by the organising team.' },
  { icon: 'mail', title: 'Early Application', text: 'Please submit your visa application through the nearest Indian Embassy, High Commission or e-Visa portal at least 6–8 weeks before March 2027.' },
];
---
<BaseLayout title="Visa Information">
  <PageHeader
    eyebrow="International participants"
    title="Visa Information"
    intro="Guidance for international delegates travelling to New Delhi, India for the International Workshop in March 2027."
  />

  <section class="section">
    <div class="container narrow">
      <div class="note blue">
        <p class="note-title">International Delegation Notice</p>
        <p>With ~75 participants from about 20 countries invited to attend the workshop in New Delhi, all international delegates are advised to ensure their passports are valid for at least 6 months beyond the travel date and to apply early for a Conference Visa.</p>
      </div>

      <ol class="visa-steps">
        {steps.map((s) => (
          <li class="visa-step">
            <span class="vs-ic"><Icon name={s.icon} size={24} /></span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>

      <div class="visa-cta card accent">
        <div>
          <h3>Need a Letter of Invitation?</h3>
          <p>Invited international participants may request official documentation and visa support from the Convenor.</p>
        </div>
        <a href={`mailto:${convenor.email}`} class="btn btn-primary">Request Invitation Letter <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>

  <style>
    .visa-steps { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; }
    .visa-step { display: flex; gap: 1.1rem; align-items: flex-start; background: #fff; border: 1px solid var(--line);
      border-radius: var(--r-lg); padding: 1.4rem; box-shadow: var(--shadow-sm); }
    .vs-ic { flex: none; width: 52px; height: 52px; border-radius: var(--r-md); background: var(--orange-50); color: var(--orange-600); display: grid; place-items: center; }
    .visa-step h3 { margin: 0.1rem 0 0.3rem; }
    .visa-step p { color: var(--ink-500); margin: 0; }
    .visa-cta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; flex-wrap: wrap; }
    .visa-cta h3 { margin: 0 0 0.3rem; }
    .visa-cta p { margin: 0; color: var(--ink-500); }
  </style>
</BaseLayout>
