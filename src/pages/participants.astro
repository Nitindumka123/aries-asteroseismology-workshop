---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { participants, event } from '../data/site';

const profile = [
  { icon: 'users', title: '~75 Invited Participants', text: 'Curated international delegation of experts in asteroseismology and star clusters.' },
  { icon: 'globe', title: 'Over 20 Countries', text: 'Global representation across India, Russia, China, Iran, Europe, Africa, Americas & Asia.' },
  { icon: 'star', title: 'Interdisciplinary Focus', text: 'Theorists, observational astronomers, and data science specialists.' },
  { icon: 'award', title: 'DST Supported', text: 'Organized under the DST SAPTARISI project (DST/ICD/Call-5/BRICS/SAPTARISI/2023/G).' },
];

const indianParticipants = participants.filter((p) => p.country === 'India');
const intlParticipants = participants.filter((p) => p.country !== 'India');
---
<BaseLayout title="Registered Participants">
  <PageHeader
    eyebrow="Delegates Directory"
    title="Registered Participants"
    intro="The International Workshop brings together invited participants and registered delegates from about 20 countries across the globe."
  />

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Participant Profile</span><h2>An International Cohort</h2></div>
      <div class="grid grid-4">
        {profile.map((p) => (
          <div class="card accent">
            <span class="card-icon"><Icon name={p.icon} size={22} /></span>
            <h4>{p.title}</h4>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Registered Participant List -->
  <section class="section soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Public Directory</span>
        <h2>Registered Participants Directory</h2>
        <p>Public listings display basic non-sensitive information only (Name, Institution, Country, Research Area &amp; Contribution Type). Private details are strictly protected.</p>
      </div>

      <!-- Stats row -->
      <div class="stats-row">
        <div class="stat-pill"><span class="sp-num" id="stat-total">{participants.length}</span> Total Delegates</div>
        <div class="stat-pill"><span class="sp-num">{indianParticipants.length}</span> Indian Institutions</div>
        <div class="stat-pill"><span class="sp-num">{intlParticipants.length}</span> International Institutions</div>
        <div class="stat-pill"><span class="sp-num">~20</span> Countries</div>
      </div>

      <!-- Container for dynamic self-registered additions -->
      <div id="self-reg-container" class="self-reg-block" hidden>
        <h3 class="self-reg-title"><Icon name="user-check" size={20} /> Recently Confirmed Registrations</h3>
        <div id="self-reg-grid" class="participant-grid"></div>
      </div>

      <h3 class="nom-title">Nominated Delegate List ({participants.length})</h3>

      <div class="participant-grid">
        {participants.map((p) => (
          <div class="part-card card">
            <div class="part-top">
              <span class="part-num">#{p.no}</span>
              <span class={`chip ${p.country === 'India' ? 'chip-blue' : 'chip-orange'}`}>{p.country}</span>
            </div>
            <h3 class="part-name">{p.name}</h3>
            <p class="part-affil"><Icon name="building" size={14} /> {p.affil}</p>
          </div>
        ))}
      </div>

      <div class="note" style="margin-top:2rem;">
        <p class="note-title">Privacy Protection Policy</p>
        <p>In compliance with privacy standards, private details such as email addresses, travel schedules, flight/train numbers, and food preferences are strictly confidential and never displayed on public pages.</p>
      </div>
    </div>
  </section>

  <style>
    .stats-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .stat-pill { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.5rem 1.2rem;
      font-size: 0.9rem; font-weight: 600; color: var(--ink-700); display: inline-flex; align-items: center; gap: 0.5rem; }
    .sp-num { font-family: var(--font-head); font-weight: 800; color: var(--orange-600); }
    
    .self-reg-block { margin-bottom: 2.5rem; background: #eef2fc; border: 1px solid var(--blue-100); border-radius: var(--r-lg); padding: 1.5rem; }
    .self-reg-title { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: var(--navy-900); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.2rem; }
    .self-reg-title :global(svg) { color: var(--blue-600); }
    .nom-title { font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; color: var(--navy-900); margin-bottom: 1.2rem; }

    .participant-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
    .part-card { padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; border-radius: var(--r-md); background: #fff; }
    .part-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
    .part-num { font-family: var(--font-head); font-weight: 700; font-size: 0.8rem; color: var(--ink-400); }
    .part-name { font-family: var(--font-head); font-weight: 700; font-size: 1.02rem; color: var(--navy-900); margin: 0 0 0.4rem; }
    .part-affil { font-size: 0.88rem; color: var(--ink-500); margin: 0 0 0.35rem; display: inline-flex; align-items: center; gap: 0.4rem; }
    .part-affil :global(svg) { color: var(--orange-500); flex: none; }
    .part-tag { font-size: 0.82rem; color: var(--blue-700); font-weight: 600; margin: 0; }
    
    @media (max-width: 960px) { .participant-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .participant-grid { grid-template-columns: 1fr; } }
  </style>

  <script>
    interface PublicParticipant {
      id: string;
      name: string;
      affil: string;
      country: string;
      researchArea?: string;
      participationType?: string;
      date?: string;
    }

    function loadSelfRegistered() {
      try {
        const raw = localStorage.getItem('aries_public_participants');
        if (!raw) return;
        const list: PublicParticipant[] = JSON.parse(raw);
        if (!list.length) return;

        const container = document.getElementById('self-reg-container');
        const grid = document.getElementById('self-reg-grid');
        const statTotal = document.getElementById('stat-total');

        if (grid && container) {
          grid.innerHTML = list.map((p) => `
            <div class="part-card card" style="border-top: 3px solid var(--blue-600);">
              <div class="part-top">
                <span class="part-num">${p.id || 'REG'}</span>
                <span class="chip ${p.country === 'India' ? 'chip-blue' : 'chip-orange'}">${p.country || 'India'}</span>
              </div>
              <h3 class="part-name">${p.name}</h3>
              <p class="part-affil"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--orange-500);flex:none;"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12h12"/><path d="M6 7h12"/><path d="M6 17h12"/></svg> ${p.affil}</p>
              ${p.researchArea ? `<p class="part-tag">Field: ${p.researchArea}</p>` : ''}
              ${p.participationType ? `<p class="part-tag" style="color:var(--orange-600);">${p.participationType}</p>` : ''}
            </div>
          `).join('');
          container.removeAttribute('hidden');
        }

        if (statTotal) {
          statTotal.textContent = String(107 + list.length);
        }
      } catch (e) {
        console.error('Error loading self-registered participants:', e);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadSelfRegistered);
    } else {
      loadSelfRegistered();
    }
  </script>
</BaseLayout>
