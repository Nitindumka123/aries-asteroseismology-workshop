---
import { nav, event, institute } from '../data/site';
import Icon from './Icon.astro';
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href?: string) => !!href && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const groupActive = (children?: { href: string }[]) => !!children?.some((c) => isActive(c.href));
---
<header class="site-header" data-header>
  <!-- ROW 1: WORKSHOP IDENTITY HEADER -->
  <div class="workshop-identity-bar">
    <div class="workshop-identity-inner">
      <!-- LEFT: Simple ARIES logo only -->
      <div class="header-col header-col-left">
        <a href="/" class="brand-link" aria-label="ARIES - Home">
          <img
            src="/images/aries-emblem.png"
            alt="ARIES official emblem"
            class="brand-logo"
            width="130"
            height="67"
          />
        </a>
      </div>

      <!-- CENTER: Workshop Title -->
      <div class="header-col header-col-center">
        <span class="workshop-kicker">INTERNATIONAL WORKSHOP</span>
        <span class="workshop-on">on</span>
        <div class="workshop-title">
          <span class="title-primary">Synergistic Investigation of Stellar Clusters and Asteroseismology</span>
          <span class="title-secondary">using High-resolution Spectroscopy and Space Photometry</span>
        </div>
      </div>

      <!-- RIGHT: Date -->
      <div class="header-col header-col-right">
        <span class="workshop-date">8–11 February 2027</span>
        <button class="nav-toggle tablet-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
          <Icon name="menu" size={22} />
          <span class="toggle-text">Menu</span>
        </button>
      </div>

      <!-- MOBILE ONLY MENU BUTTON (Flows after date) -->
      <div class="header-mobile-action">
        <button class="mobile-menu-btn" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
          <Icon name="menu" size={20} />
          <span>Menu</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ROW 2: Existing navigation bar -->
  <nav class="nav-bar" aria-label="Primary">
    <div class="nav-inner">
      <ul class="nav-list">
        {nav.map((item) => item.children ? (
          <li class="nav-item has-children">
            <button class="nav-link nav-more" aria-expanded="false" aria-haspopup="true" class:list={[{ active: groupActive(item.children) }]}>{item.label}<Icon name="chevron-down" size={16} /></button>
            <ul class="dropdown">{item.children.map((c) => <li><a href={c.href} class="dropdown-link" class:list={[{ active: isActive(c.href) }]}>{c.label}</a></li>)}</ul>
          </li>
        ) : <li class="nav-item"><a href={item.href} class="nav-link" class:list={[{ active: isActive(item.href) }]}>{item.label}</a></li>)}
      </ul>
    </div>
  </nav>
</header>

<div class="drawer-overlay" data-overlay hidden></div>
<aside id="mobile-drawer" class="mobile-drawer" data-drawer aria-hidden="true" aria-label="Site menu">
  <div class="drawer-head"><span class="drawer-title">Menu</span><button class="drawer-close" data-nav-close aria-label="Close menu"><Icon name="close" size={24} /></button></div>
  <nav aria-label="Mobile"><ul class="drawer-list">
    {nav.map((item) => item.children ? (
      <li><button class="drawer-acc" data-acc aria-expanded="false">{item.label}<Icon name="chevron-down" size={18} /></button><ul class="drawer-sub" data-acc-panel>{item.children.map((c) => <li><a href={c.href} class:list={[{ active: isActive(c.href) }]}>{c.label}</a></li>)}</ul></li>
    ) : <li><a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a></li>)}
  </ul></nav>
</aside>

<style>
  /* =========================================================================
     SITE HEADER — TWO-ROW ARCHITECTURE
     Row 1: Workshop Identity (Logo | Title | Date)
     Row 2: Primary Navigation Bar
     ========================================================================= */
  .site-header {
    position: relative;
    z-index: 100;
    background: #ffffff;
    width: 100%;
  }

  /* ---- ROW 1: WORKSHOP IDENTITY HEADER ---- */
  .workshop-identity-bar {
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    position: relative;
    width: 100%;
  }

  .workshop-identity-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding: 1.35rem 2rem;
    column-gap: 1.75rem;
    box-sizing: border-box;
  }

  /* Left column: Short/simple ARIES logo */
  .header-col-left {
    justify-self: start;
    display: flex;
    align-items: center;
    min-width: 130px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .brand-link:hover {
    opacity: 0.88;
  }

  .brand-logo {
    display: block;
    height: 52px;
    width: auto;
    max-width: 135px;
    object-fit: contain;
  }

  /* Center column: Workshop Title */
  .header-col-center {
    justify-self: center;
    text-align: center;
    max-width: 900px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .workshop-kicker {
    display: block;
    color: var(--orange-600);
    font-family: var(--font-head);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .workshop-on {
    display: block;
    color: var(--ink-500);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.2;
    margin-block: 0.12rem 0.22rem;
  }

  .workshop-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.22rem;
    margin: 0;
    padding: 0;
  }

  .title-primary {
    display: block;
    color: var(--navy-900);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.18rem, 1.45vw, 1.5rem);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .title-secondary {
    display: block;
    color: var(--navy-900);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.08rem, 1.3vw, 1.36rem);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -0.005em;
    text-align: center;
  }

  /* Right column: 8–11 February 2027 */
  .header-col-right {
    justify-self: end;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
    min-width: 130px;
    text-align: right;
  }

  .workshop-date {
    display: block;
    color: var(--orange-600);
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .tablet-toggle {
    display: none;
    background: var(--navy-900);
    color: #ffffff;
    border: 0;
    border-radius: var(--r-md);
    padding: 0.5rem 0.85rem;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .tablet-toggle:hover {
    background: var(--blue-700);
  }

  .header-mobile-action {
    display: none;
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--navy-900);
    color: #ffffff;
    border: 0;
    border-radius: var(--r-md);
    padding: 0.55rem 1.35rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.15s ease;
  }
  .mobile-menu-btn:hover {
    background: var(--blue-700);
  }

  /* ---- ROW 2: PRIMARY NAVIGATION BAR ---- */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 90;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 1px 3px rgba(16, 29, 71, 0.04);
  }

  .nav-inner {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    box-sizing: border-box;
  }

  .nav-list {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: flex;
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink-600);
    background: none;
    border: 0;
    padding: 0.95rem 0.55rem;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--blue-700);
    background: var(--bg-soft);
  }
  .nav-link.active {
    color: var(--navy-900);
    border-bottom-color: var(--orange-500);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--orange-500);
    border-radius: 0 0 var(--r-md) var(--r-md);
    box-shadow: var(--shadow-md);
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 100;
  }
  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown,
  .dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-item:last-child .dropdown,
  .nav-item:nth-last-child(2) .dropdown {
    left: auto;
    right: 0;
  }

  .dropdown-link {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-sm);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-600);
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .dropdown-link:hover,
  .dropdown-link.active {
    background: var(--blue-50);
    color: var(--blue-700);
  }

  /* ---- MOBILE DRAWER ---- */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(11, 21, 51, 0.5);
    z-index: 200;
  }
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100dvh;
    width: min(360px, 92vw);
    background: #ffffff;
    z-index: 201;
    transform: translateX(100%);
    transition: transform 0.28s ease;
    overflow-y: auto;
    box-shadow: -8px 0 30px rgba(11, 21, 51, 0.18);
  }
  .mobile-drawer.open {
    transform: translateX(0);
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: var(--navy-900);
    color: #ffffff;
  }
  .drawer-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .drawer-close {
    background: rgba(255, 255, 255, 0.12);
    border: 0;
    color: #ffffff;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: var(--r-sm);
  }

  .drawer-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
  }
  .drawer-list > li > a,
  .drawer-acc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--ink-700);
    padding: 0.85rem 0.75rem;
    border: 0;
    background: none;
    text-align: left;
    border-radius: var(--r-sm);
  }
  .drawer-list a.active,
  .drawer-acc.active {
    color: var(--navy-900);
    background: var(--orange-50);
  }
  .drawer-sub {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.5rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }
  .drawer-sub.open {
    max-height: 240px;
  }
  .drawer-sub a {
    display: block;
    padding: 0.7rem 1rem;
    color: var(--ink-500);
    border-left: 3px solid var(--line);
  }

  /* =========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================= */
  /* Tablet breakpoint: under 1160px, hide desktop nav bar and show tablet toggle */
  @media (max-width: 1160px) {
    .nav-bar {
      display: none;
    }
    .tablet-toggle {
      display: inline-flex;
    }
    .workshop-identity-inner {
      padding-inline: 1.5rem;
    }
  }

  /* Mobile breakpoint: under 960px, switch from 3-column to clean stacked flow */
  @media (max-width: 960px) {
    .tablet-toggle {
      display: none;
    }
    .workshop-identity-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.15rem 1.25rem 1.35rem;
      gap: 0.8rem;
    }
    .header-col-left {
      min-width: 0;
      justify-content: center;
    }
    .brand-logo {
      height: 48px;
    }
    .header-col-center {
      width: 100%;
      max-width: 100%;
      padding-inline: 0.25rem;
    }
    .workshop-kicker {
      font-size: 0.76rem;
      letter-spacing: 0.1em;
    }
    .workshop-on {
      font-size: 0.88rem;
      margin-block: 0.1rem 0.18rem;
    }
    .title-primary {
      font-size: clamp(1.05rem, 3.8vw, 1.28rem);
      line-height: 1.28;
    }
    .title-secondary {
      font-size: clamp(0.95rem, 3.4vw, 1.15rem);
      line-height: 1.28;
    }
    .header-col-right {
      min-width: 0;
      justify-content: center;
      text-align: center;
    }
    .workshop-date {
      font-size: 0.95rem;
      text-align: center;
    }
    .header-mobile-action {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: 0.25rem;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll('[data-nav-toggle]');
  const closeBtn = document.querySelector('[data-nav-close]');
  const drawer = document.querySelector('[data-drawer]');
  const overlay = document.querySelector('[data-overlay]');

  const closeDrawer = () => {
    drawer?.classList.remove('open');
    overlay?.setAttribute('hidden', '');
    drawer?.setAttribute('aria-hidden', 'true');
    toggles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    document.body.style.overflow = '';
  };

  toggles.forEach((t) => {
    t.addEventListener('click', () => {
      drawer?.classList.add('open');
      overlay?.removeAttribute('hidden');
      drawer?.setAttribute('aria-hidden', 'false');
      t.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });

  document.querySelectorAll('[data-acc]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.nextElementSibling?.classList.toggle('open', !open);
    });
  });

  document.querySelectorAll('.nav-more').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const dd = btn.parentElement?.querySelector('.dropdown');
      dd?.classList.toggle('open');
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.dropdown.open').forEach((d) => d.classList.remove('open'));
  });
</script>

