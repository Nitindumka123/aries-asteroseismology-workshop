---
import { nav, event, institute } from '../data/site';
import Icon from './Icon.astro';
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href?: string) => !!href && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const groupActive = (children?: { href: string }[]) => !!children?.some((c) => isActive(c.href));
---
<header class="site-header" data-header>
  <div class="brand-bar">
    <div class="container brand-inner">
      <a href="/" class="brand" aria-label={`${institute.acronym} - ${event.name}, home`}>
        <span class="brand-mark" role="img" aria-label="ARIES official logo"></span>
      </a>
      <div class="header-title">
        <span class="header-kicker">INTERNATIONAL WORKSHOP</span>
        <span class="header-on">on</span>
        <span class="header-event-title">Synergistic Investigation of Stellar Clusters and Asteroseismology<br class="desktop-break" /> using High-resolution Spectroscopy and Space Photometry</span>
      </div>
      <div class="brand-aside">
        <span class="header-date">8-11 February 2027</span>
        <button class="nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer"><Icon name="menu" size={26} /></button>
      </div>
    </div>
  </div>
  <nav class="nav-bar" aria-label="Primary">
    <div class="container nav-inner">
      <ul class="nav-list">
        {nav.map((item) => item.children ? (
          <li class="nav-item has-children">
            <button class="nav-link nav-more" aria-expanded="false" aria-haspopup="true" class:list={[{ active: groupActive(item.children) }]}>{item.label}<Icon name="chevron-down" size={16} /></button>
            <ul class="dropdown">{item.children.map((c) => <li><a href={c.href} class="dropdown-link" class:list={[{ active: isActive(c.href) }]}>{c.label}</a></li>)}</ul>
          </li>
        ) : <li class="nav-item"><a href={item.href} class="nav-link" class:list={[{ active: isActive(item.href) }]}>{item.label}</a></li>)}
      </ul>
    </div>
  </nav>
</header>

<div class="drawer-overlay" data-overlay hidden></div>
<aside id="mobile-drawer" class="mobile-drawer" data-drawer aria-hidden="true" aria-label="Site menu">
  <div class="drawer-head"><span class="drawer-title">Menu</span><button class="drawer-close" data-nav-close aria-label="Close menu"><Icon name="close" size={24} /></button></div>
  <nav aria-label="Mobile"><ul class="drawer-list">
    {nav.map((item) => item.children ? (
      <li><button class="drawer-acc" data-acc aria-expanded="false">{item.label}<Icon name="chevron-down" size={18} /></button><ul class="drawer-sub" data-acc-panel>{item.children.map((c) => <li><a href={c.href} class:list={[{ active: isActive(c.href) }]}>{c.label}</a></li>)}</ul></li>
    ) : <li><a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a></li>)}
  </ul></nav>
</aside>

<style>
  .site-header { position: relative; z-index: 100; background: #fff; }
  .brand-bar { border-bottom: 1px solid var(--line); }
  .brand-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 78px; position: relative; }
  .brand { display: inline-flex; align-items: center; flex: none; }
  .brand-mark { display: block; width: 190px; height: 48px; background: url('/images/aries-logo.png') left center / auto 48px no-repeat; }
  .header-title { position: absolute; left: 50%; transform: translateX(-50%); width: min(820px, calc(100% - 430px)); text-align: center; line-height: 1.08; }
  .header-kicker { display: block; color: var(--orange-600); font-family: var(--font-head); font-size: 0.88rem; font-weight: 800; letter-spacing: 0.14em; }
  .header-on { display: block; color: var(--ink-500); font-family: Georgia, serif; font-size: 1rem; font-style: italic; margin: 0.2rem 0; }
  .header-event-title { display: block; color: var(--navy-900); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.2rem, 2vw, 1.75rem); font-weight: 700; }
  .header-date { display: block; max-width: 150px; color: var(--orange-600); font-family: var(--font-head); font-size: .95rem; font-weight: 800; line-height: 1.2; text-align: right; }
  .brand-aside { display: flex; align-items: center; gap: 1.1rem; margin-left: auto; }
  .nav-toggle { display: none; background: var(--navy-900); color: #fff; border: 0; border-radius: var(--r-md); width: 46px; height: 46px; place-items: center; }
  .nav-bar { position: sticky; top: 0; z-index: 90; background: #fff; border-bottom: 1px solid var(--line); }
  .nav-list { display: flex; align-items: stretch; justify-content: space-between; gap: 0.05rem; list-style: none; margin: 0; padding: 0; }
  .nav-item { display: flex; position: relative; }
  .nav-link { display: inline-flex; align-items: center; gap: 0.2rem; font-family: var(--font-head); font-weight: 600; font-size: 0.855rem; color: var(--ink-600); background: none; border: 0; padding: 0.95rem 0.5rem; border-bottom: 3px solid transparent; white-space: nowrap; }
  .nav-link:hover { color: var(--blue-700); background: var(--bg-soft); }
  .nav-link.active { color: var(--navy-900); border-bottom-color: var(--orange-500); }
  .dropdown { position: absolute; top: 100%; right: 0; min-width: 250px; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--orange-500); border-radius: 0 0 var(--r-md) var(--r-md); box-shadow: var(--shadow-md); list-style: none; margin: 0; padding: 0.4rem; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .16s ease, transform .16s ease, visibility .16s; }
  .has-children:hover .dropdown, .has-children:focus-within .dropdown, .dropdown.open { opacity: 1; visibility: visible; transform: translateY(0); }
  .dropdown-link { display: block; padding: 0.6rem 0.8rem; border-radius: var(--r-sm); font-family: var(--font-head); font-weight: 600; font-size: 0.9rem; color: var(--ink-600); }
  .dropdown-link:hover, .dropdown-link.active { background: var(--blue-50); color: var(--blue-700); }
  .drawer-overlay { position: fixed; inset: 0; background: rgba(11,21,51,.5); z-index: 200; }
  .mobile-drawer { position: fixed; top: 0; right: 0; height: 100dvh; width: min(360px, 92vw); background: #fff; z-index: 201; transform: translateX(100%); transition: transform .28s ease; overflow-y: auto; box-shadow: -8px 0 30px rgba(11,21,51,.18); }
  .mobile-drawer.open { transform: translateX(0); }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; background: var(--navy-900); color: #fff; }
  .drawer-title { font-family: var(--font-head); font-weight: 700; }
  .drawer-close { background: rgba(255,255,255,.12); border: 0; color: #fff; width: 38px; height: 38px; display: grid; place-items: center; }
  .drawer-list { list-style: none; margin: 0; padding: .5rem .75rem; }
  .drawer-list > li > a, .drawer-acc { display: flex; align-items: center; justify-content: space-between; width: 100%; font-family: var(--font-head); font-weight: 600; color: var(--ink-700); padding: .85rem .75rem; border: 0; background: none; text-align: left; }
  .drawer-list a.active, .drawer-acc.active { color: var(--navy-900); background: var(--orange-50); }
  .drawer-sub { list-style: none; margin: 0; padding: 0 0 0 .5rem; max-height: 0; overflow: hidden; transition: max-height .25s ease; }
  .drawer-sub.open { max-height: 240px; }
  .drawer-sub a { display: block; padding: .7rem 1rem; color: var(--ink-500); border-left: 3px solid var(--line); }
  @media (max-width: 1199px) { .nav-bar { display: none; } .nav-toggle { display: grid; } .header-title { width: min(700px, calc(100% - 360px)); } }
  @media (max-width: 720px) {
    .brand-mark { width: 78px; height: 34px; background-size: auto 34px; }
    .brand-inner { min-height: 118px; padding-block: .4rem; align-items: flex-start; }
    .header-title { position: absolute; left: 50%; top: 45px; transform: translateX(-50%); width: calc(100% - 1.5rem); padding-inline: .25rem; }
    .header-kicker { font-size: .62rem; letter-spacing: .08em; }
    .header-on { font-size: .76rem; margin: .08rem 0; }
    .header-event-title { font-size: clamp(.86rem, 3.2vw, 1.1rem); line-height: 1.12; }
    .header-date { font-size: .68rem; margin-top: .15rem; }
    .header-date { position: absolute; top: 14px; right: 3.5rem; max-width: 112px; font-size: .68rem; text-align: right; }
    .desktop-break { display: none; }
    .brand-aside { gap: 0; }
    .nav-toggle { width: 40px; height: 40px; }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const closeBtn = document.querySelector('[data-nav-close]');
  const drawer = document.querySelector('[data-drawer]');
  const overlay = document.querySelector('[data-overlay]');
  const closeDrawer = () => { drawer?.classList.remove('open'); overlay?.setAttribute('hidden', ''); drawer?.setAttribute('aria-hidden', 'true'); toggle?.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; };
  toggle?.addEventListener('click', () => { drawer?.classList.add('open'); overlay?.removeAttribute('hidden'); drawer?.setAttribute('aria-hidden', 'false'); toggle?.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; });
  closeBtn?.addEventListener('click', closeDrawer); overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
  document.querySelectorAll('[data-acc]').forEach((btn) => btn.addEventListener('click', () => { const open = btn.getAttribute('aria-expanded') === 'true'; btn.setAttribute('aria-expanded', String(!open)); btn.nextElementSibling?.classList.toggle('open', !open); }));
  document.querySelectorAll('.nav-more').forEach((btn) => btn.addEventListener('click', (e) => { e.stopPropagation(); const dd = btn.parentElement?.querySelector('.dropdown'); dd?.classList.toggle('open'); }));
  document.addEventListener('click', () => document.querySelectorAll('.dropdown.open').forEach((d) => d.classList.remove('open')));
</script>
