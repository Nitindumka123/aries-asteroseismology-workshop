---
import { nav } from '../data/site';
import Icon from './Icon.astro';
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href?: string) => !!href && (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const groupActive = (children?: { href: string }[]) => !!children?.some((c) => isActive(c.href));
---
<header class="site-header" data-header>
  <!-- ROW 1: WORKSHOP IDENTITY HEADER (Centered Title + Date, No Left Logo) -->
  <div class="workshop-identity-bar">
    <div class="workshop-identity-inner">
      <div class="workshop-identity-content">
        <span class="workshop-kicker">INTERNATIONAL WORKSHOP</span>
        <span class="workshop-on">on</span>
        <h1 class="title-primary">Synergistic Investigation of Stellar Clusters and Asteroseismology</h1>
        <p class="title-secondary">using High-resolution Spectroscopy and Space Photometry</p>
        <p class="workshop-date">8–11 February 2027</p>
      </div>

      <!-- Mobile / Tablet Menu Button -->
      <button class="nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <Icon name="menu" size={22} />
        <span>Menu</span>
      </button>
    </div>
  </div>

  <!-- ROW 2: PRIMARY NAVIGATION BAR -->
  <nav class="nav-bar" aria-label="Primary">
    <div class="nav-inner">
      <ul class="nav-list">
        {nav.map((item) => item.children ? (
          <li class="nav-item has-children">
            <button class="nav-link nav-more" aria-expanded="false" aria-haspopup="true" class:list={[{ active: groupActive(item.children) }]}>
              {item.label}<Icon name="chevron-down" size={16} />
            </button>
            <ul class="dropdown">
              {item.children.map((c) => (
                <li>
                  <a href={c.href} class="dropdown-link" class:list={[{ active: isActive(c.href) }]}>
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li class="nav-item">
            <a href={item.href} class="nav-link" class:list={[{ active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<div class="drawer-overlay" data-overlay hidden></div>
<aside id="mobile-drawer" class="mobile-drawer" data-drawer aria-hidden="true" aria-label="Site menu">
  <div class="drawer-head">
    <span class="drawer-title">Menu</span>
    <button class="drawer-close" data-nav-close aria-label="Close menu">
      <Icon name="close" size={24} />
    </button>
  </div>
  <nav aria-label="Mobile">
    <ul class="drawer-list">
      {nav.map((item) => item.children ? (
        <li>
          <button class="drawer-acc" data-acc aria-expanded="false">
            {item.label}<Icon name="chevron-down" size={18} />
          </button>
          <ul class="drawer-sub" data-acc-panel>
            {item.children.map((c) => (
              <li>
                <a href={c.href} class:list={[{ active: isActive(c.href) }]}>
                  {c.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  /* =========================================================================
     SITE HEADER — TWO-ROW ARCHITECTURE
     Row 1: Workshop Identity (Centered Title + Next-Line Date)
     Row 2: Primary Navigation Bar
     ========================================================================= */
  .site-header {
    position: relative;
    z-index: 100;
    background: #ffffff;
    width: 100%;
    box-shadow: var(--shadow-sm);
  }

  /* ---- ROW 1: WORKSHOP IDENTITY HEADER ---- */
  .workshop-identity-bar {
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    position: relative;
    width: 100%;
  }

  .workshop-identity-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1380px;
    margin-inline: auto;
    padding: 1.5rem 1.75rem 1.35rem;
    box-sizing: border-box;
    text-align: center;
  }

  .workshop-identity-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 1320px;
    width: 100%;
    margin: 0 auto;
  }

  .workshop-kicker {
    display: block;
    color: var(--orange-600);
    font-family: var(--font-head);
    font-size: clamp(0.88rem, 1.05vw, 1.08rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .workshop-on {
    display: block;
    color: var(--ink-500);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(0.98rem, 1.15vw, 1.18rem);
    font-style: italic;
    line-height: 1.2;
    margin-block: 0.2rem 0.35rem;
  }

  /* Exactly 2 lines: Line 1 (primary) and Line 2 (secondary) */
  .title-primary {
    display: block;
    color: var(--navy-950);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.08rem, 1.68vw, 1.75rem);
    font-weight: 800;
    line-height: 1.24;
    letter-spacing: -0.015em;
    text-align: center;
    margin: 0;
  }

  .title-secondary {
    display: block;
    color: var(--navy-900);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(0.95rem, 1.28vw, 1.35rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.005em;
    text-align: center;
    margin: 0.35rem 0 0;
  }

  @media (min-width: 820px) {
    .title-primary,
    .title-secondary {
      white-space: nowrap;
    }
  }

  .workshop-date {
    display: block;
    color: var(--orange-600);
    font-family: var(--font-head);
    font-size: clamp(1.08rem, 1.35vw, 1.28rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin: 0.75rem 0 0;
    text-align: center;
  }

  /* Menu toggle for tablet and mobile */
  .nav-toggle {
    display: none;
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: var(--navy-900);
    color: #ffffff;
    border: 0;
    border-radius: var(--r-md);
    padding: 0.5rem 0.85rem;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.15s ease;
  }
  .nav-toggle:hover {
    background: var(--blue-700);
  }

  /* ---- ROW 2: PRIMARY NAVIGATION BAR ---- */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 90;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 1px 3px rgba(16, 29, 71, 0.04);
  }

  .nav-inner {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    box-sizing: border-box;
  }

  .nav-list {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: flex;
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink-600);
    background: none;
    border: 0;
    padding: 0.95rem 0.55rem;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
    cursor: pointer;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--blue-700);
    background: var(--bg-soft);
  }
  .nav-link.active {
    color: var(--navy-900);
    border-bottom-color: var(--orange-500);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--orange-500);
    border-radius: 0 0 var(--r-md) var(--r-md);
    box-shadow: var(--shadow-md);
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 100;
  }
  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown,
  .dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-item:last-child .dropdown,
  .nav-item:nth-last-child(2) .dropdown {
    left: auto;
    right: 0;
  }

  .dropdown-link {
    display: block;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-sm);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-600);
    text-decoration: none;
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .dropdown-link:hover,
  .dropdown-link.active {
    background: var(--bg-soft);
    color: var(--blue-700);
  }

  /* ---- MOBILE DRAWER ---- */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(11, 21, 51, 0.5);
    z-index: 200;
  }
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100dvh;
    width: min(340px, 85vw);
    background: #ffffff;
    z-index: 201;
    transform: translateX(100%);
    transition: transform 0.28s ease;
    overflow-y: auto;
    box-shadow: -4px 0 24px rgba(11, 21, 51, 0.2);
  }
  .mobile-drawer.open {
    transform: translateX(0);
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: var(--navy-900);
    color: #ffffff;
  }
  .drawer-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .drawer-close {
    background: none;
    border: 0;
    color: #ffffff;
    padding: 0.25rem;
    cursor: pointer;
  }
  .drawer-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
  }
  .drawer-list > li > a,
  .drawer-acc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--ink-700);
    padding: 0.85rem 0.75rem;
    border: 0;
    background: none;
    text-align: left;
    border-radius: var(--r-sm);
    cursor: pointer;
    text-decoration: none;
  }
  .drawer-list a.active,
  .drawer-acc.active {
    color: var(--navy-900);
    background: var(--orange-50);
  }
  .drawer-sub {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.5rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }
  .drawer-sub.open {
    max-height: 240px;
  }
  .drawer-sub a {
    display: block;
    padding: 0.7rem 1rem;
    color: var(--ink-500);
    border-left: 3px solid var(--line);
    text-decoration: none;
  }
  .drawer-sub a.active {
    color: var(--orange-600);
    border-left-color: var(--orange-500);
    font-weight: 600;
  }

  /* =========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================= */
  @media (max-width: 1160px) {
    .nav-bar {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
    .workshop-identity-inner {
      padding-right: 6rem;
    }
  }

  @media (max-width: 768px) {
    .workshop-identity-inner {
      padding: 1.15rem 1rem 1.25rem;
      flex-direction: column;
      gap: 0.75rem;
    }
    .nav-toggle {
      position: static;
      transform: none;
      margin-top: 0.25rem;
    }
    .workshop-kicker {
      font-size: clamp(0.85rem, 3.2vw, 0.95rem);
      letter-spacing: 0.12em;
    }
    .workshop-on {
      font-size: 1rem;
      margin-block: 0.15rem 0.25rem;
    }
    .title-primary {
      font-size: clamp(1.28rem, 5.2vw, 1.65rem);
      line-height: 1.25;
    }
    .title-secondary {
      font-size: clamp(1.05rem, 4.2vw, 1.3rem);
      line-height: 1.28;
    }
    .workshop-date {
      font-size: clamp(1.05rem, 3.8vw, 1.18rem);
      margin-top: 0.55rem;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll('[data-nav-toggle]');
  const closeBtn = document.querySelector('[data-nav-close]');
  const drawer = document.querySelector('[data-drawer]');
  const overlay = document.querySelector('[data-overlay]');

  const closeDrawer = () => {
    drawer?.classList.remove('open');
    overlay?.setAttribute('hidden', '');
    drawer?.setAttribute('aria-hidden', 'true');
    toggles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    document.body.style.overflow = '';
  };

  toggles.forEach((t) => {
    t.addEventListener('click', () => {
      drawer?.classList.add('open');
      overlay?.removeAttribute('hidden');
      drawer?.setAttribute('aria-hidden', 'false');
      t.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });

  document.querySelectorAll('[data-acc]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.nextElementSibling?.classList.toggle('open', !open);
    });
  });

  document.querySelectorAll('.nav-more').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const dd = btn.parentElement?.querySelector('.dropdown');
      dd?.classList.toggle('open');
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.dropdown.open').forEach((d) => d.classList.remove('open'));
  });
</script>
