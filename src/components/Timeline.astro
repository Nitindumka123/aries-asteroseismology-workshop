---
import Icon from './Icon.astro';
export interface Props {
  items: { label: string; date: string; note?: string; status?: string }[];
}
const { items } = Astro.props;
const statusMeta: Record<string, { chip: string; text: string }> = {
  done: { chip: 'chip-blue', text: 'Completed' },
  closed: { chip: 'chip-closed', text: 'Closed' },
  event: { chip: 'chip-orange', text: 'Event' },
};
---
<ol class="timeline">
  {items.map((it) => {
    const meta = it.status ? statusMeta[it.status] : undefined;
    const isEvent = it.status === 'event';
    return (
      <li class:list={['tl-item', { 'is-event': isEvent }]}>
        <span class="tl-node" aria-hidden="true">
          {isEvent ? <Icon name="star" size={14} /> : <Icon name="check" size={14} />}
        </span>
        <div class="tl-body">
          <div class="tl-top">
            <span class="tl-label">{it.label}</span>
            {meta && <span class={`chip ${meta.chip}`}>{meta.text}</span>}
          </div>
          <p class="tl-date">{it.date}</p>
          {it.note && <p class="tl-note">{it.note}</p>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 15px; top: 8px; bottom: 8px; width: 2px; background: var(--line-strong); }
  .tl-item { position: relative; display: flex; gap: 1.1rem; padding-bottom: 1.6rem; }
  .tl-item:last-child { padding-bottom: 0; }
  .tl-node { position: relative; z-index: 1; flex: none; width: 32px; height: 32px; border-radius: 50%;
    background: #fff; border: 2px solid var(--blue-600); color: var(--blue-600);
    display: grid; place-items: center; }
  .tl-item.is-event .tl-node { border-color: var(--orange-500); color: #fff; background: var(--orange-500); }
  .tl-body { flex: 1; padding-top: 0.15rem; }
  .tl-top { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .tl-label { font-family: var(--font-head); font-weight: 700; color: var(--navy-900); font-size: 1.05rem; }
  .tl-date { color: var(--ink-600); font-weight: 600; margin: 0.2rem 0 0; }
  .tl-item.is-event .tl-date { color: var(--orange-600); font-size: 1.15rem; }
  .tl-note { color: var(--ink-500); font-size: 0.92rem; margin: 0.15rem 0 0; }
</style>
